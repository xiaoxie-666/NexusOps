# Local development configuration for NexusOps.
# Copy this file to .env and replace every CHANGE_ME value before starting the stack.
# Never commit your real .env file or reuse development credentials in production.
APP_NAME=NexusOps Incident Intelligence Platform
APP_ENV=development

BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_ENGINEER_PASSWORD=CHANGE_ME_ENGINEER_PASSWORD
BOOTSTRAP_ONCALL_PASSWORD=CHANGE_ME_ONCALL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD

# Mock mode starts without downloading local LLM weights.
# Set AI_PROVIDER=ollama to enable Qwen inference.
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
KNOWLEDGE_EMBEDDING_PROVIDER=ollama

# Optional OpenAI-compatible provider. Leave API key empty for local-only mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Default first-run mode uses BM25 only. Enable vectors after Ollama + bge-m3 are ready.
KNOWLEDGE_VECTOR_ENABLED=false
KNOWLEDGE_VECTOR_REQUIRED=false
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_MAX_CHUNKS_PER_SOURCE=1
CHROMA_PERSIST_DIR=/app/data/nexusops-chroma
CHROMA_SNAPSHOT_DIR=/app/data/nexusops-chroma-snapshots
CHROMA_COLLECTION_NAME=nexusops_knowledge

ALERT_EMAIL_DELIVERY_MODE=log
ALERT_EMAIL_SUBJECT_PREFIX=[NexusOps 事件预警]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

MODEL_ROUTER_ENABLED=true
MODEL_FALLBACK_PROVIDER=mock
MODEL_FALLBACK_MODEL=mock
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_RESET_SECONDS=30
MODEL_REQUEST_TIMEOUT_SECONDS=120
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=768
AGENT_MODEL_RESOLUTION_TEMPERATURE=0.2
AGENT_MODEL_RESOLUTION_MAX_TOKENS=1024
INCIDENT_ANALYSIS_MAX_ROUNDS=8
INCIDENT_ANALYSIS_MIN_CONFIDENCE=0.55

ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_MAX_PAYLOAD_BYTES=1000000
INCIDENT_TOOL_QUEUE_ENABLED=true
INCIDENT_TOOL_POLL_INTERVAL_SECONDS=1
INCIDENT_TOOL_MAX_ATTEMPTS=3
INCIDENT_TOOL_RETRY_DELAY_SECONDS=10
ONCALL_NOTIFICATION_RECIPIENTS=
OPS_KNOWLEDGE_AUTO_SEED=true

INCIDENT_CONTEXT_CACHE_ENABLED=true
INCIDENT_CONTEXT_CACHE_TTL_SECONDS=3600
INCIDENT_CONTEXT_SUMMARY_MAX_CHARS=500
INCIDENT_CONTEXT_TOKEN_BUDGET=2300
EXCEL_PATH=/app/data/nexusops-incident-ledger.xlsx

# Optional per-Agent overrides. Empty values inherit AI_PROVIDER / OLLAMA_MODEL.
AGENT_MODEL_UNDERSTANDING_PROVIDER=
AGENT_MODEL_UNDERSTANDING_MODEL=
AGENT_MODEL_IMPACT_PROVIDER=
AGENT_MODEL_IMPACT_MODEL=
AGENT_MODEL_RESOLUTION_PROVIDER=
AGENT_MODEL_RESOLUTION_MODEL=
AGENT_MODEL_GUARD_PROVIDER=
AGENT_MODEL_GUARD_MODEL=
